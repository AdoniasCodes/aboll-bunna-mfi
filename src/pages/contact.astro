---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { org } from '../data/site';

const crumbs = [{ name: 'Contact', path: '/contact/' }];
---
<Base
  title="Contact Aboll Bunna Microfinance | Phone, Office, Branches"
  description="To contact Aboll Bunna Microfinance, call +251 11 558 2258 or visit our head office behind Dembel City Center, Addis Ababa. Six branches serve you."
  path="/contact/"
  crumbs={crumbs}
>
  <PageHero title="Contact Aboll Bunna Microfinance" intro="We are here to help with all your financial needs. Call, email or visit us, and let's thrive together." crumbs={crumbs} />

  <section class="section">
    <div class="wrap split contact">
      <div>
        <h2>Call or visit</h2>
        <ul class="contact-list">
          {org.phones.map((p) => <li><span>{p.label}</span><a href={`tel:${p.tel}`}>{p.display}</a></li>)}
          <li><span>Email</span><a href={`mailto:${org.email}`}>{org.email}</a></li>
        </ul>
        <h3>Head office</h3>
        <address>
          {org.address.line}<br />{org.address.area}<br />{org.address.city}, Ethiopia<br />
          <span lang="am" class="am">{org.address.lineAm}</span>
        </address>
        <p><a class="text-link" href={org.mapUrl} rel="noopener" target="_blank">Open in Google Maps</a></p>
        <h3>Branches</h3>
        <ul class="ticks">{org.branches.map((b) => <li>{b}</li>)}</ul>
      </div>

      <form class="form" action={`mailto:${org.email}`} method="post" enctype="text/plain">
        <h2>Send us a message</h2>
        <p>Fill out this form and we will get back to you shortly.</p>
        <label>Full name<input name="name" autocomplete="name" required /></label>
        <label>Phone number<input name="phone" type="tel" autocomplete="tel" inputmode="tel" required /></label>
        <label>Email (optional)<input name="email" type="email" autocomplete="email" /></label>
        <label>How can we help?
          <select name="topic">
            <option>Loan</option><option>Saving account</option><option>Financial literacy training</option><option>Shareholder question</option><option>Other</option>
          </select>
        </label>
        <label>Message<textarea name="message" rows="5" required></textarea></label>
        <button class="btn" type="submit">Send message</button>
      </form>
    </div>
  </section>
</Base>
