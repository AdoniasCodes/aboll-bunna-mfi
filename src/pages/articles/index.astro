---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { u } from '../../lib/url';

const crumbs = [{ name: 'News and notices', path: '/articles/' }];
const posts = (await getCollection('articles')).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title="Aboll Bunna Shareholder Notices and News | Microfinance"
  description="Read Aboll Bunna shareholder notices: general assembly calls, annual board reports and announcements from Aboll Bunna Microfinance S.C., mostly in Amharic."
  path="/articles/"
  crumbs={crumbs}
>
  <PageHero title="Aboll Bunna shareholder notices and news" intro="General assembly calls, annual board reports and announcements from Aboll Bunna Microfinance S.C. Most notices are published in Amharic." crumbs={crumbs} />
  <section class="section">
    <div class="wrap narrow">
      <ol class="post-list">
        {posts.map((p) => (
          <li>
            <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
            <h2><a href={u(`/articles/${p.id}/`)} lang="am">{p.data.title}</a></h2>
            <p class="post-en">{p.data.titleEn}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
