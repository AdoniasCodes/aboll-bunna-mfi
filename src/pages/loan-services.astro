---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProductList from '../components/ProductList.astro';
import CallBand from '../components/CallBand.astro';
import { loans } from '../data/site';
import { abs } from '../lib/url';

const crumbs = [{ name: 'Services', path: '/services/' }, { name: 'Loan services', path: '/loan-services/' }];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Loan products',
  itemListElement: loans.map((l) => ({ '@type': 'Offer', itemOffered: { '@type': 'LoanOrCredit', name: l.name, description: l.text, url: abs(`/loan-services/#${l.slug}`, Astro.site) } })),
}];
---
<Base
  title="Loan Services in Addis Ababa | Aboll Bunna Microfinance"
  description="Aboll Bunna loan services in Addis Ababa: SME, micro business, agriculture, housing, women, youth, consumer and emergency loans. Call +251 11 558 2258."
  path="/loan-services/"
  crumbs={crumbs}
  schema={schema}
>
  <PageHero title="Loan services in Addis Ababa" intro="Thirteen loan products to support your business, personal and community needs. Together we thrive." crumbs={crumbs}>
    <p class="hero-note">At Aboll Bunna Microfinance S.C., we offer a comprehensive range of loan products designed to empower individuals, businesses, and communities. Whether you are looking to start a small business, invest in agriculture, purchase property, or handle emergencies, we have the right financial solution for you.</p>
  </PageHero>
  <section class="section"><div class="wrap"><ProductList items={loans} /></div></section>
  <CallBand title="Ready to apply?" text="Call us or visit a branch. Rates depend on the loan type and repayment period, and our staff will explain the terms before you sign." />
</Base>
