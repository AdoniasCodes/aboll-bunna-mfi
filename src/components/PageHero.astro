---
import { t, lp, type Lang } from '../i18n';
import { u } from '../lib/url';
interface Props { lang: Lang; title: string; intro: string; crumbs?: { name: string; path: string }[] }
const { lang, title, intro, crumbs = [] } = Astro.props;
const d = t(lang);
---
<section class="page-hero">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="crumbs">
        <a href={u(lp(lang, '/'))}>{d.nav.breadcrumbHome}</a>
        {crumbs.map((c, i) => (i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={u(lp(lang, c.path))}>{c.name}</a>))}
      </nav>
    )}
    <h1>{title}</h1>
    <p class="lede">{intro}</p>
    <slot />
  </div>
</section>
