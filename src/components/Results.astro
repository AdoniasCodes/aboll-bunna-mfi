---
import Icon from './Icon.astro';
import { results } from '../data/site';
import { t, lp, type Lang } from '../i18n';
import { u } from '../lib/url';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const r = d.results;
const money = (v: string) => (lang === 'am' ? `${v} ${r.million} ${r.etb}` : `${r.etb} ${v}${r.million}`);
const cells = [
  { label: r.customers, value: results.customers, note: r.customersNote },
  { label: r.deposits, value: money(results.deposits), note: r.depositsNote },
  { label: r.loans, value: money(results.loans), note: r.loansNote },
  { label: r.assets, value: money(results.assets), note: r.assetsNote },
];
---
<section class="results" aria-labelledby="results-h">
  <div class="wrap">
    <div class="results-head">
      <h2 id="results-h">{r.h}</h2>
      <p>{r.sub}</p>
    </div>
    <dl class="stats">
      {cells.map((c) => (
        <div class="stat">
          <dt>{c.label}</dt>
          <dd>{c.value}</dd>
          <p><Icon name="trend" size={16} /> {c.note}</p>
        </div>
      ))}
    </dl>
    <a class="link-light" href={u(lp(lang, '/articles/board-annual-report-2025-2026/'))}><Icon name="file" size={18} /> {d.ui.readReport}</a>
  </div>
</section>
