---
import { results, org } from '../data/site';
import { u } from '../lib/url';
---
<section class="results" aria-labelledby="results-h">
  <div class="wrap">
    <h2 id="results-h">Our {results.period} in numbers</h2>
    <p class="results-sub">From the Board of Directors' annual report to shareholders, fiscal year ended 30 June 2026.</p>
    <dl class="ledger">
      <div><dt>Customers served</dt><dd>{results.customers}</dd><p>up {results.customersGrowth} on the year before</p></div>
      <div><dt>Customer deposits</dt><dd>ETB {results.deposits}</dd><p>up {results.depositsGrowth} on the year before</p></div>
      <div><dt>Loans disbursed</dt><dd>ETB {results.loans}</dd><p>to small businesses, farmers and families</p></div>
      <div><dt>Total assets</dt><dd>ETB {results.assets}</dd><p>double the previous year</p></div>
      <div><dt>Branches</dt><dd>{results.branches}</dd><p>{org.branches.join(', ')}</p></div>
    </dl>
    <a class="text-link" href={u('/articles/board-annual-report-2025-2026/')}>Read the full annual report (Amharic)</a>
  </div>
</section>
