---
import { faqs } from '../data/site';
---
<section class="section faq" aria-labelledby="faq-h">
  <div class="wrap narrow">
    <h2 id="faq-h">Frequently asked questions</h2>
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>
