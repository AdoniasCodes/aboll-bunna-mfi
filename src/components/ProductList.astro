---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { items: { slug: string; name: string; text: string; img: ImageMetadata }[]; heading?: 'h2' | 'h3' }
const { items, heading = 'h2' } = Astro.props;
const H = heading;
---
<ul class="products">
  {items.map((p) => (
    <li id={p.slug}>
      <Image src={p.img} alt={p.name} widths={[160, 320]} sizes="160px" width={160} height={160} />
      <div>
        <H>{p.name}</H>
        <p>{p.text}</p>
      </div>
    </li>
  ))}
</ul>
