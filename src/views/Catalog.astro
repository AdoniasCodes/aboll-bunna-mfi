---
// Loans, savings and financial literacy pages share one layout.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CtaPanel from '../components/CtaPanel.astro';
import { loans, savings, literacy } from '../data/site';
import { t, lp, type Lang } from '../i18n';
import { abs } from '../lib/url';

type Kind = 'loans' | 'savings' | 'literacy';
const { lang, kind } = Astro.props as { lang: Lang; kind: Kind };
const d = t(lang);
const cfg = {
  loans: { path: '/loan-services/', list: loans, page: d.loansPage, crumb: d.ui.loanServices, type: 'LoanOrCredit' },
  savings: { path: '/saving-services/', list: savings, page: d.savingsPage, crumb: d.ui.savingServices, type: 'DepositAccount' },
  literacy: { path: '/financial-literacy-and-consultancy/', list: literacy, page: d.literacyPage, crumb: d.ui.financialLiteracy, type: 'Service' },
}[kind];
const texts = d.products[kind] as Record<string, { name: string; text: string }>;
const items = cfg.list.map((p) => ({ ...p, ...texts[p.slug] }));
const crumbs = [{ name: d.nav.services, path: '/services/' }, { name: cfg.crumb, path: cfg.path }];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: cfg.page.h1,
  inLanguage: lang,
  itemListElement: items.map((i) => ({ '@type': 'Offer', itemOffered: { '@type': cfg.type, name: i.name, description: i.text, url: abs(`${lp(lang, cfg.path)}#${i.slug}`, Astro.site) } })),
}];
---
<Base lang={lang} title={d.meta[kind].title} description={d.meta[kind].description} path={cfg.path} crumbs={crumbs} schema={schema}>
  <PageHero lang={lang} title={cfg.page.h1} intro={cfg.page.intro} crumbs={crumbs}>
    <p class="hero-note">{cfg.page.note}</p>
  </PageHero>
  <section class="section"><div class="wrap"><ProductGrid items={items} /></div></section>
  <CtaPanel lang={lang} title={cfg.page.ctaH} text={cfg.page.ctaText} />
</Base>
